<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F5E9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="30dp">

        <!-- TÍTULO -->

        <TextView
            android:id="@+id/txtTituloNuevaTarea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:text="➕ Nueva tarea"
            android:textColor="#1B5E20"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtituloNuevaTarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Agrega una nueva tarea a tu día"
            android:textColor="#607D63"
            android:textSize="16sp" />


        <!-- FORMULARIO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="#FFFFFF"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="24dp">


            <!-- NOMBRE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre de la tarea"
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtNombreTarea"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="6dp"
                android:hint="Ej: Estudiar para la prueba"
                android:inputType="textCapSentences"
                android:padding="12dp" />


            <!-- DESCRIPCIÓN -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Descripción"
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtDescripcionTarea"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="6dp"
                android:gravity="top"
                android:hint="Agrega algunos detalles..."
                android:inputType="textCapSentences|textMultiLine"
                android:padding="12dp" />


            <!-- PRIORIDAD -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Prioridad"
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioPrioridad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioBaja"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Baja"
                    android:textColor="#4E6B50" />

                <RadioButton
                    android:id="@+id/radioMedia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟡 Media"
                    android:textColor="#4E6B50" />

                <RadioButton
                    android:id="@+id/radioAlta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔴 Alta"
                    android:textColor="#4E6B50" />

            </RadioGroup>


            <!-- CATEGORÍA -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Categoría"
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerCategoria"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="5dp" />


            <!-- BOTÓN -->

            <Button
                android:id="@+id/btnGuardarTarea"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="25dp"
                android:backgroundTint="#388E3C"
                android:text="💾  CREAR TAREA"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- VOLVER -->

        <TextView
            android:id="@+id/txtCancelarTarea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:text="← Volver al Dashboard"
            android:textColor="#2E7D32"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>