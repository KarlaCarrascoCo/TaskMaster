<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F5E9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="30dp">

        <!-- Logo -->

        <ImageView
            android:id="@+id/imgRegistro"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_marginTop="35dp"
            android:contentDescription="Logo TaskMaster"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="#2E7D32" />

        <!-- Título -->

        <TextView
            android:id="@+id/txtTituloRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="¡Únete a TaskMaster! 🌱"
            android:textColor="#1B5E20"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtituloRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Crea tu cuenta y comienza a organizar tu día"
            android:textColor="#607D63"
            android:textSize="15sp" />

        <!-- Formulario -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="#FFFFFF"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Nombre -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre"
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtNombreRegistro"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="5dp"
                android:hint="¿Cómo te llamas?"
                android:inputType="textPersonName"
                android:padding="12dp" />

            <!-- Usuario -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Nombre de usuario"
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtUsuarioRegistro"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="5dp"
                android:hint="Ej: karla123"
                android:inputType="text"
                android:padding="12dp" />

            <!-- Contraseña -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Contraseña"
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtPasswordRegistro"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="5dp"
                android:hint="Crea una contraseña"
                android:inputType="textPassword"
                android:padding="12dp" />

            <!-- Confirmar contraseña -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Confirmar contraseña"
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtConfirmarPassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="5dp"
                android:hint="Repite tu contraseña"
                android:inputType="textPassword"
                android:padding="12dp" />

            <!-- Términos -->

            <CheckBox
                android:id="@+id/chkTerminos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Acepto crear mi cuenta en TaskMaster"
                android:textColor="#4E6B50" />

            <!-- Botón -->

            <Button
                android:id="@+id/btnCrearCuenta"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="15dp"
                android:backgroundTint="#388E3C"
                android:text="🌱  CREAR CUENTA"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Volver -->

        <TextView
            android:id="@+id/txtVolverLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="← Ya tengo una cuenta"
            android:textColor="#2E7D32"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>